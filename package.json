{
  "name": "@pinooxhq/slug",
  "version": "0.1.3",
  "description": "Persian-to-Finglish transliteration and URL slugs for Vue, React, Svelte, and vanilla JS.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js",
      "require": "./dist/vue/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "import": "./dist/svelte/index.js",
      "require": "./dist/svelte/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.fa.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "svelte": ">=4",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.8",
    "react": "^19.1.0",
    "svelte": "^5.56.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vue": "^3.5.35"
  },
  "keywords": [
    "pinoox",
    "slug",
    "slugify",
    "finglish",
    "pinglish",
    "persian",
    "farsi",
    "transliteration",
    "vue",
    "react",
    "svelte"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinoox/slug.git"
  },
  "homepage": "https://github.com/pinoox/slug#readme",
  "bugs": {
    "url": "https://github.com/pinoox/slug/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
